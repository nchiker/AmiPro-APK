<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The network is used ONLY for "Check for updates" (an anonymous request to GitHub's releases, then the download of the app
         file when the person taps Download). Documents never leave the phone except where the user saves them. Nothing runs in
         the background. REQUEST_INSTALL_PACKAGES lets that update be handed to Android's installer (the person still confirms). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Share with Stack: Android hides other apps unless they are named here. -->
    <queries>
        <package android:name="${stackPackage}" />
        <package android:name="app.filenfiles" />
    </queries>
    <application
        android:name=".AmiProApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AmiPro">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with": Ami Pro documents. Files named .sam, and files a provider reports with a generic or the
                 Linux app's type (application/x-amipro-document; unknown extensions arrive as octet-stream). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/x-amipro-document" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <!-- A path pattern is ignored unless a host is declared; without this the filter matched every file. -->
                <data android:host="*" />
                <data android:pathPattern=".*\\.sam" />
                <data android:pathPattern=".*\\.SAM" />
                <data android:pathPattern=".*\\.Sam" />
                <data android:pathPattern=".*\\.amipro" />
            </intent-filter>
        </activity>
        <!-- Stack asks here to open a file it holds a link to. Exported, but only Stack's pinned signing certificate is answered. -->
        <provider
            android:name=".StackLinkProvider"
            android:authorities="${applicationId}.stacklink"
            android:exported="true" />
        <!-- Android's installer reports the result of an update here (and hands over its confirmation screen). -->
        <receiver android:name=".InstallResultReceiver" android:exported="false" />
    </application>
</manifest>
